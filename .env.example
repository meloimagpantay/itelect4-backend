# Copy this file to .env and fill in your own values.
# .env is in .gitignore -- it must never be committed.

# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/itelect4
# Local:  mongodb://127.0.0.1:27017/itelect4
MONGODB_URI=

# Any long random string. Change it and every issued token stops working.
JWT_SECRET=

# Which websites the browser may let read this API's replies. Comma
# separated, no trailing slash, and the scheme and port are part of it.
# On your laptop that is the Vite dev server; on Vercel it is the one
# address your frontend is served from.
CORS_ORIGIN=http://localhost:5173

# From aistudio.google.com -> Get API key. Server-side only: it is
# never sent to the browser, and never committed. The quota belongs to
# the Google project behind the key, so keep your own.
GEMINI_API_KEY=

PORT=4000
